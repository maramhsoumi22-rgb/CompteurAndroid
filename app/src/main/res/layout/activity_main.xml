<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Titre -->
    <TextView
        android:id="@+id/textViewTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/titre_compteur"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Card pour l'affichage de la valeur du compteur -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCompteur"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/background_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewTitre">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:id="@+id/textViewCompteur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/valeur_initiale"
                android:textSize="72sp"
                android:textStyle="bold"
                android:textColor="@color/color_neutre" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Boutons d'action principaux : + et - -->
    <LinearLayout
        android:id="@+id/layoutBoutonsPrincipaux"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardCompteur">

        <Button
            android:id="@+id/buttonDecrementer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/bouton_moins"
            android:textSize="26sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/buttonIncrementer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/bouton_plus"
            android:textSize="26sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Boutons bonus d'incrémentation rapide (+5 / -5) -->
    <LinearLayout
        android:id="@+id/layoutBoutonsBonus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutBoutonsPrincipaux">

        <Button
            android:id="@+id/buttonMoinsCinq"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/bouton_moins_cinq"
            android:textSize="18sp"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/buttonPlusCinq"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/bouton_plus_cinq"
            android:textSize="18sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Bouton Réinitialiser -->
    <Button
        android:id="@+id/buttonReinitialiser"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/bouton_reinitialiser"
        android:textSize="18sp"
        android:textColor="@color/purple_700"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutBoutonsBonus" />

</androidx.constraintlayout.widget.ConstraintLayout>
